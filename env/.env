#! /bin/bash
echo "[DEBUG] sourcing $(realpath "${BASH_SOURCE[0]}")"
set -euo pipefail

##
## General config
##

#@ Some paths to be used accross all scripts
scriptpath="$(realpath "${BASH_SOURCE[1]}")"
ENV_FILE="$(realpath "${BASH_SOURCE[0]}")"
ENV_PATH="$(dirname "$ENV_FILE")"
REPO_PATH="$(dirname "$ENV_PATH")"
DEMO_PATH="${REPO_PATH}" #> /demo"
LIB_PATH="${REPO_PATH}/lib"
CFG_PATH="${REPO_PATH}/cfg"
TMP_PATH="${REPO_PATH}/tmp"
tmp=$TMP_PATH
mkdir -p "$tmp"

